# 저장소: Turso (https://turso.tech). 운영 상태(켜짐/꺼짐)와 관리 번호 오입력 횟수만 저장합니다. GPS 좌표는 저장하지 않습니다.
# 로컬 개발에서는 비워 두면 .dev-status.json 파일에 저장합니다. 시험용 TURSO_DATABASE_URL=file:./local.db 도 가능.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# 테이블 이름 앞부분 (한 DB 를 여러 프로젝트가 나눠 쓸 때 구분). 기본값 gps
# TABLE_PREFIX=gps

# 관리 페이지 번호(예: 4자리). 설정하면 관리 페이지에 들어갈 때 입력해야 하고, 연속 5번 틀리면 1분간 잠깁니다.
# 실제 번호는 코드에 적지 말고 Vercel 환경변수에만 넣으세요.
ADMIN_KEY=
